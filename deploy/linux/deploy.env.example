# Absolute path to the separately transferred private data package.
DATA_ROOT=/absolute/path/to/audio-embedding-data

IMAGE_NAME=maiagent-muq-audio:torch2.5.1-cu124
GPU_DEVICES=all
SHM_SIZE=16g
TENSORBOARD_PORT=6006
RUN_AS_HOST_USER=1

# Paths are relative to this file's directory unless absolute.
CONFIG_FILE=../../configs/training.example.yaml

# Docker build options. Weights are downloaded during build, never stored in Git.
INCLUDE_MUQ_WEIGHTS=1
MUQ_MODEL_ID=OpenMuQ/MuQ-large-msd-iter
PYPI_INDEX_URL=https://pypi.org/simple

# Set both to 0 when the image does not contain model weights.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
